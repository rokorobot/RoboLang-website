---
import { nav, versions } from '../data/facts';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap">
    <a class="brand wide" href="/" aria-label="RoboLang.dev home">
      Robo<b>Lang</b><span class="tld">.dev</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="header-tag">Simulation only · <strong>v{versions.distribution}</strong></p>

    <details class="mmenu">
      <summary>
        <span class="mmenu-icon" aria-hidden="true"><i></i><i></i><i></i></span>
        Menu
      </summary>
      <nav class="mmenu-panel" aria-label="Menu">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={current === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
