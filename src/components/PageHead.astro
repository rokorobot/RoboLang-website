---
interface Props {
  /** Two-digit position of the page in the navigation, e.g. "02". */
  index: string;
  label: string;
  title: string;
}

const { index, label, title } = Astro.props;
---

<header class="page-head">
  <div class="wrap">
    <p class="gate">{index} / {label}</p>
    <div class="sh">
      <h1>{title}</h1>
      <p class="lede"><slot /></p>
    </div>
  </div>
</header>
